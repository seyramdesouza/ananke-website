---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  person: CollectionEntry<'people'>;
  size?: 'default' | 'large';
  /** Hide the bio (e.g. compact team grids on the homepage). */
  compact?: boolean;
}

const { person, size = 'default', compact = false } = Astro.props;
const { name, roleTitle, country, practice, photo, links } = person.data;
const { Content } = await render(person);
const hasBio = Boolean(person.body?.trim());
const meta = [country, practice].filter(Boolean).join(' · ');
const initials = name
  .split(/\s+/)
  .filter((part) => /^[A-Z]/.test(part))
  .slice(0, 2)
  .map((part) => part[0])
  .join('');
---

<article class:list={['person', `person--${size}`]}>
  <h3 class="name">{name}</h3>
  <div class="portrait">
    {photo ? <img src={photo} alt={`Portrait of ${name}`} loading="lazy" /> : <span class="initials" aria-hidden="true">{initials}</span>}
    {roleTitle && <p class="role">{roleTitle}</p>}
  </div>
  {
    !compact && (
      <div class="details">
        {meta && <p class="meta">{meta}</p>}
        <div class="bio">{hasBio ? <Content /> : <p class="muted">Biography to follow.</p>}</div>
        {links.length > 0 && (
          <ul class="links" role="list">
            {links.map((l) => (
              <li>
                <a href={l.url} target="_blank" rel="noopener">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        )}
        <slot />
      </div>
    )
  }
</article>

<style>
  .person {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .name {
    font-size: var(--step-2);
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
  }

  .portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    background: var(--sage);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .person--default .portrait {
    aspect-ratio: 1;
  }

  .portrait img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%; /* keep faces in frame when cropping */
  }

  .initials {
    font-family: var(--display);
    font-variation-settings: 'opsz' 144;
    font-weight: 300;
    font-size: clamp(3rem, 2rem + 4vw, 5.5rem);
    color: var(--forest);
    opacity: 0.55;
  }

  .role {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    margin: 0;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: rgb(14 36 4 / 0.72);
    color: var(--cream);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .meta {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--sage-ink);
    margin: 0.25rem 0 0;
  }

  .bio {
    margin-top: 0.5rem;
    color: var(--forest-2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
    font-weight: 500;
  }
</style>
