---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmptyState from '../../components/EmptyState.astro';

const projects = (await getCollection('community')).sort(
  (a, b) => (b.data.startDate?.getTime() ?? 0) - (a.data.startDate?.getTime() ?? 0),
);
---

<BaseLayout
  title="Community Projects"
  description="Ananke develops participatory projects that invite people to contribute to cultural conversations."
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Projects', href: '/projects/' }, { label: 'Community Projects' }]}
>
  <PageHeader eyebrow="Participation" title="Community Projects" />

  <section class="container">
    <blockquote class="pullquote pull">Culture does not belong only to institutions.</blockquote>
    <div class="prose dropcap">
      <p>
        Ananke develops participatory projects that invite people to contribute their experiences, knowledge and
        perspectives to cultural conversations.
      </p>
      <p>
        We are interested in creating spaces where audiences become participants, where local knowledge is valued, and
        where cultural exchange becomes something experienced rather than simply observed.
      </p>
    </div>
  </section>

  <section class="section container">
    {
      projects.length > 0 ? (
        <div class="grid-3">
          {projects.map((p) => (
            <article class="card">
              {p.data.image && <img src={p.data.image} alt="" loading="lazy" />}
              <h2 class="card-title">{p.data.title}</h2>
              <p class="card-meta">
                {[p.data.location, p.data.startDate?.getFullYear()].filter(Boolean).join(' · ')}
              </p>
              {p.data.partners.length > 0 && <p class="card-meta">With {p.data.partners.join(', ')}</p>}
              {p.data.summary && <p>{p.data.summary}</p>}
            </article>
          ))}
        </div>
      ) : (
        <EmptyState>
          <p>
            Community projects are in development. To take part, partner or propose an idea, please
            <a href="/contact/">get in touch</a>.
          </p>
        </EmptyState>
      )
    }
  </section>
</BaseLayout>

<style>
  .pull {
    margin: 0 0 var(--space-l);
  }

  .card img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
    margin-bottom: 1rem;
  }

  .card-title {
    font-size: var(--step-2);
    margin-bottom: 0.5rem;
  }

  .card-meta {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
</style>
