---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmptyState from '../../components/EmptyState.astro';

// Intro copy is provisional (taken from About Ananke) until Research copy is written.
const projects = (await getCollection('research')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Research"
  description="Cultural research at Ananke Projects."
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Projects', href: '/projects/' }, { label: 'Research' }]}
>
  <PageHeader
    eyebrow="Cultural research"
    title="Research"
    lead="Our work explores how culture can preserve memory, challenge assumptions, create dialogue and make room for perspectives that have not always occupied the centre."
  />

  <section class="section container">
    {
      projects.length > 0 ? (
        <ul class="list" role="list">
          {projects.map((p) => (
            <li class="item">
              <div>
                <h2 class="item-title">{p.data.title}</h2>
                {p.data.collaborators.length > 0 && <p class="item-meta">With {p.data.collaborators.join(', ')}</p>}
              </div>
              <div>
                <p class="caps status">{p.data.status}</p>
                {p.data.summary && <p>{p.data.summary}</p>}
                {p.data.file && <a href={p.data.file}>Download</a>}
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState>
          <p>Research projects will be published here.</p>
        </EmptyState>
      )
    }
  </section>
</BaseLayout>

<style>
  .item {
    display: grid;
    gap: 1rem var(--space-m);
    padding-block: var(--space-m);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 48rem) {
    .item {
      grid-template-columns: 1fr 1.4fr;
    }
  }

  .item-title {
    font-size: var(--step-2);
  }

  .item-meta {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  .status {
    font-size: 0.7rem;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
</style>
