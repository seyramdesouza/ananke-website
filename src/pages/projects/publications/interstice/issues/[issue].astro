---
import { getCollection, getEntries, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import ArrowLink from '../../../../../components/ArrowLink.astro';
import IssueCover from '../../../../../components/IssueCover.astro';
import Colophon from '../../../../../components/Colophon.astro';
import EmptyState from '../../../../../components/EmptyState.astro';
import { INTERSTICE } from '../../../../../data/navigation';

export async function getStaticPaths() {
  const issues = await getCollection('issues', ({ data }) => data.status === 'published');
  return issues.map((issue) => ({ params: { issue: issue.id }, props: { issue } }));
}

interface Props {
  issue: CollectionEntry<'issues'>;
}

const { issue } = Astro.props;
const {
  label,
  numeral,
  year,
  summary,
  standfirst,
  cover,
  coverAlt,
  publisher,
  place,
  issn,
  readUrl,
  pdf,
  pdfSize,
  sections,
  credits,
  copyright,
  acknowledgements,
  excerpts,
  closingQuote,
} = issue.data;
const { Content } = await render(issue);
const hasEditorsNote = Boolean(issue.body?.trim());

const editors = await getEntries(issue.data.editors);

const works = (await getCollection('works', ({ data }) => data.issue.id === issue.id)).sort(
  (a, b) => a.data.order - b.data.order,
);
const contributorIds = [...new Set(works.flatMap((w) => w.data.contributors.map((c) => c.id)))];
const contributors = contributorIds.length
  ? await getEntries(contributorIds.map((id) => ({ collection: 'people' as const, id })))
  : [];
const peopleById = new Map(contributors.map((p) => [p.id, p.data.name]));

// Group works by section, keeping the issue's section order; unsectioned works go last.
const sectionOrder = [...sections, ...new Set(works.map((w) => w.data.section ?? ''))].filter(
  (s, i, all) => all.indexOf(s) === i,
);
const grouped = sectionOrder
  .map((name) => ({ name, items: works.filter((w) => (w.data.section ?? '') === name) }))
  .filter((g) => g.items.length > 0);

const next = (await getCollection('issues')).find((i) => i.data.number === issue.data.number + 1);
const readHref = readUrl ?? '#contents';
const pdfName = pdf?.split('/').pop();
---

<BaseLayout
  title={`${label} — Interstice`}
  description={summary}
  interstice
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Projects', href: '/projects/' },
    { label: 'Publications', href: '/projects/publications/' },
    { label: 'Interstice', href: INTERSTICE },
    { label: 'Issues', href: `${INTERSTICE}issues/` },
    { label },
  ]}
>
  <!-- Hero -->
  <header class="container issue-hero">
    <div class="issue-cover">
      <IssueCover numeral={numeral} year={year} cover={cover} alt={coverAlt} />
    </div>
    <div class="issue-intro">
      <p class="eyebrow eyebrow--accent">Interstice</p>
      <h1 class="issue-title">{label}</h1>
      <div class="issue-summary">
        {summary && <p class="lead">{summary}</p>}
        {standfirst && <p class="prose">{standfirst}</p>}
      </div>
      <dl class="facts issue-facts">
        {works.length > 0 && <div><dt>Works</dt><dd>{works.length}</dd></div>}
        {contributors.length > 0 && <div><dt>Contributors</dt><dd>{contributors.length}</dd></div>}
        {grouped.length > 0 && <div><dt>Sections</dt><dd>{grouped.length}</dd></div>}
        {place && <div><dt>Published in</dt><dd>{place}</dd></div>}
      </dl>
      <div class="hero-actions">
        {
          pdf ? (
            <ArrowLink href={pdf} variant="solid" download={pdfName}>
              Download the Issue
            </ArrowLink>
          ) : (
            <ArrowLink href={readHref} variant="solid" external={Boolean(readUrl)}>
              {readUrl ? 'Read the Issue' : 'Explore the Issue'}
            </ArrowLink>
          )
        }
        {pdf && <span class="pdf-meta">PDF{pdfSize && ` · ${pdfSize}`}</span>}
        {pdf && <ArrowLink href="#contents">Contents</ArrowLink>}
        {hasEditorsNote && <ArrowLink href="#editors-note">Editor's note</ArrowLink>}
      </div>
    </div>
  </header>

  <!-- Editor's note -->
  {
    hasEditorsNote && (
      <section id="editors-note" class="section container" aria-labelledby="note-title">
        <div class="split">
          <h2 id="note-title" class="eyebrow">Editor's Note</h2>
          <div class="prose dropcap editors-note">
            <Content />
          </div>
        </div>
      </section>
    )
  }

  <!-- Foreword & special reflection -->
  {
    excerpts.length > 0 && (
      <section class="section container" aria-label="Foreword and reflection">
        <div class="excerpts">
          {excerpts.map((x) => (
            <figure class="excerpt" data-reveal>
              <p class="excerpt-heading">{x.heading}</p>
              {x.title && <h2 class="excerpt-title">{x.title}</h2>}
              <blockquote class="excerpt-text">
                <p>{x.text}</p>
              </blockquote>
              <figcaption>
                <span class="excerpt-author">{x.author}</span>
                {x.affiliation && <span class="excerpt-affiliation">{x.affiliation}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <!-- Contents -->
  <section id="contents" class="section container" aria-labelledby="contents-title">
    <div class="split">
      <h2 id="contents-title" class="eyebrow">Explore the Issue</h2>
      <div>
        {
          grouped.length > 0 ? (
            <ol class="sections" role="list">
              {grouped.map((group, gi) => (
                <li class="toc-section">
                  {group.name && (
                    <h3 class="toc-section-title">
                      <span class="toc-section-num">{gi + 1}</span>
                      {group.name}
                    </h3>
                  )}
                  <ol class="toc" role="list">
                    {group.items.map((work) => (
                      <li class="toc-item">
                        <div class="toc-main">
                          <span class="toc-title">
                            {work.data.title}
                            {work.data.titleTranslation && (
                              <span class="toc-translation">{work.data.titleTranslation}</span>
                            )}
                          </span>
                          <span class="toc-meta">
                            {work.data.contributors
                              .map((c) => peopleById.get(c.id))
                              .filter(Boolean)
                              .join(', ')}
                            {' · '}
                            {work.data.form}
                          </span>
                        </div>
                        {work.data.page && <span class="toc-page">p. {work.data.page}</span>}
                      </li>
                    ))}
                  </ol>
                </li>
              ))}
            </ol>
          ) : (
            <EmptyState title="Contents">
              <p>The table of contents for {label} will be published here.</p>
            </EmptyState>
          )
        }
      </div>
    </div>
  </section>

  <!-- People -->
  <section class="section container" aria-labelledby="team-title">
    <div class="split">
      <h2 id="team-title" class="eyebrow">Contributors &amp; Editorial Team</h2>
      <div class="team">
        {
          contributors.length > 0 && (
            <div>
              <h3 class="team-heading">Contributors</h3>
              <ul role="list" class="names">
                {contributors.map((p) => (
                  <li>{p.data.name}</li>
                ))}
              </ul>
              <ArrowLink href={`${INTERSTICE}contributors/`}>About the contributors</ArrowLink>
            </div>
          )
        }
        <div>
          <h3 class="team-heading">Editorial Team</h3>
          <ul role="list" class="editors">
            {
              editors.map((p) => (
                <li>
                  <span>{p.data.name}</span>
                  <span class="muted">{p.data.roleTitle}</span>
                </li>
              ))
            }
          </ul>
          <ArrowLink href={`${INTERSTICE}editorial-team/`}>Meet the editorial team</ArrowLink>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing quote -->
  {
    closingQuote && (
      <section class="section container closing" aria-label="Closing words">
        <blockquote class="closing-quote" data-reveal>
          <p>{closingQuote}</p>
        </blockquote>
      </section>
    )
  }

  <!-- Credits, acknowledgements, colophon -->
  <section class="section container" aria-labelledby="credits-title">
    <h2 id="credits-title" class="sr-only">Credits</h2>
    <div class="credits-grid">
      {
        credits.length > 0 && (
          <dl class="credits">
            {credits.map((c) => (
              <div>
                <dt>{c.role}</dt>
                <dd>{c.name}</dd>
              </div>
            ))}
          </dl>
        )
      }
      <div class="credits-side">
        {
          acknowledgements.length > 0 && (
            <div>
              <p class="eyebrow">Acknowledgements</p>
              <ul role="list" class="acks">
                {acknowledgements.map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
            </div>
          )
        }
        <Colophon label={label} publisher={publisher} place={place} issn={issn} />
        {copyright && <p class="copyright">{copyright}</p>}
      </div>
    </div>
  </section>

  <section class="container read">
    <div class="read-main">
      {
        pdf ? (
          <ArrowLink href={pdf} variant="solid" download={pdfName}>
            Download the Issue
          </ArrowLink>
        ) : (
          <ArrowLink href={readHref} variant="solid" external={Boolean(readUrl)}>
            {readUrl ? 'Read the Issue' : 'Back to contents'}
          </ArrowLink>
        )
      }
      {pdf && <span class="pdf-meta">PDF{pdfSize && ` · ${pdfSize}`}</span>}
    </div>
    {
      next && next.data.status === 'forthcoming' && (
        <p class="next">
          Next: <strong>{next.data.label}</strong> — Forthcoming ·{' '}
          <a href="/projects/publications/submissions/">Submission guidelines</a>
        </p>
      )
    }
  </section>
</BaseLayout>

<style>
  /* Hero */
  .issue-hero {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-m);
    padding-bottom: var(--space-l);
    align-items: center;
  }

  @media (min-width: 48rem) {
    .issue-hero {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      gap: var(--space-l);
    }
  }

  .issue-cover {
    max-width: 22rem;
    transform: rotate(-1.5deg);
    filter: drop-shadow(0 30px 30px rgb(14 36 4 / 0.22));
  }

  .issue-title {
    font-size: var(--step-5);
  }

  .issue-summary {
    margin: var(--space-m) 0;
  }

  .issue-summary .lead {
    margin-bottom: 1rem;
  }

  .issue-facts {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  /* Editor's note */
  .editors-note :global(p:first-child) {
    font-family: var(--display);
    font-size: var(--step-3);
    line-height: 1.1;
    color: var(--forest);
  }

  .editors-note :global(p:last-child) {
    margin-top: 2rem;
    font-size: 1rem;
  }

  /* Excerpts */
  .excerpts {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 56rem) {
    .excerpts {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .excerpt {
    margin: 0;
    padding: var(--space-m);
    border-radius: var(--radius);
    background: var(--cream-2);
    box-shadow: inset 0 0 0 1px var(--line);
    display: flex;
    flex-direction: column;
  }

  .excerpt:nth-child(2) {
    background: var(--interstice);
    color: #fff;
    box-shadow: none;
  }

  .excerpt-heading {
    font-weight: 500;
    margin-bottom: 0.75rem;
    opacity: 0.8;
  }

  .excerpt-title {
    font-size: var(--step-3);
    font-style: italic;
    margin-bottom: 1.25rem;
  }

  .excerpt-text {
    margin: 0;
    flex: 1;
    font-family: var(--display);
    font-variation-settings: 'opsz' 36;
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .excerpt figcaption {
    display: flex;
    flex-direction: column;
    margin-top: 1.5rem;
    font-size: 0.95rem;
  }

  .excerpt-author {
    font-weight: 500;
  }

  .excerpt-affiliation {
    opacity: 0.8;
  }

  /* Contents */
  .toc-section + .toc-section {
    margin-top: var(--space-m);
  }

  .toc-section-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--step-3);
    margin-bottom: 0.75rem;
  }

  .toc-section-num {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--interstice);
    color: #fff;
    font-family: var(--sans);
    font-size: 0.875rem;
    font-weight: 500;
    flex-shrink: 0;
  }

  .toc-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
  }

  .toc-main {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .toc-title {
    font-family: var(--display);
    font-variation-settings: 'opsz' 72;
    font-size: var(--step-2);
    line-height: 1.15;
  }

  .toc-translation {
    display: block;
    font-family: var(--sans);
    font-size: 0.95rem;
    font-style: italic;
    color: var(--forest-2);
  }

  .toc-meta {
    font-size: 0.95rem;
    color: var(--sage-ink);
    font-weight: 500;
  }

  .toc-page {
    font-size: 0.875rem;
    color: var(--sage-ink);
    white-space: nowrap;
  }

  /* People */
  .team {
    display: grid;
    gap: var(--space-m);
  }

  .team-heading {
    font-size: var(--step-3);
    margin-bottom: 1rem;
  }

  .names {
    columns: 2 14rem;
    column-gap: 2rem;
    margin-bottom: 1rem;
  }

  .names li {
    padding-block: 0.5rem;
    border-top: 1px solid var(--line);
    break-inside: avoid;
  }

  .editors {
    margin-bottom: 1rem;
  }

  .editors li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--line);
  }

  /* Closing quote */
  .closing {
    text-align: center;
  }

  .closing-quote {
    margin: 0 auto;
    max-width: 22ch;
    font-family: var(--display);
    font-variation-settings: 'opsz' 144;
    font-weight: 300;
    font-style: italic;
    font-size: var(--step-4);
    line-height: 1.05;
    color: var(--interstice);
  }

  .closing-quote p::before {
    content: '“';
  }

  .closing-quote p::after {
    content: '”';
  }

  /* Credits */
  .credits-grid {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 56rem) {
    .credits-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-l);
    }
  }

  .credits {
    display: grid;
    gap: 1rem 2rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    margin: 0;
  }

  .credits dt {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--sage-ink);
  }

  .credits dd {
    margin: 0.15rem 0 0;
    font-weight: 500;
  }

  .credits-side {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .acks li + li {
    margin-top: 0.25rem;
  }

  .copyright {
    font-size: 0.875rem;
    color: var(--forest-2);
    max-width: 34rem;
  }

  /* Footer actions */
  .read {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .read-main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .pdf-meta {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--sage-ink);
  }

  .next {
    margin: 0;
    color: var(--forest-2);
  }
</style>
