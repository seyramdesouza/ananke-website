---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import OpenCall from '../../../components/OpenCall.astro';
import site from '../../../content/settings/site.json';
import guidelines from '../../../content/settings/submissions.json';
import { INTERSTICE } from '../../../data/navigation';

// All wording below comes from src/content/settings/submissions.json (editable in the CMS under
// Settings → Submission Guidelines). Empty fields fall back to "published with each open call".
const email = guidelines.email || site.email;
const hasRightsOrFees = Boolean(guidelines.rights || guidelines.fees);

const sections = [
  { id: 'open-call', label: 'Current open call' },
  { id: 'what-we-accept', label: 'What we accept' },
  { id: 'how-to-submit', label: 'How to submit' },
  ...(hasRightsOrFees ? [{ id: 'rights-and-fees', label: 'Rights and fees' }] : []),
  { id: 'what-happens-next', label: 'What happens next' },
  { id: 'other-enquiries', label: 'Books and other enquiries' },
];
---

<BaseLayout
  title="Submission Guidelines"
  description="How to submit work to Ananke Editions and Interstice."
  interstice
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Projects', href: '/projects/' },
    { label: 'Publications', href: '/projects/publications/' },
    { label: 'Submission Guidelines' },
  ]}
>
  <PageHeader
    eyebrow="Ananke Editions"
    title="Submission Guidelines"
    lead="Ananke Editions welcomes work that asks questions, opens conversations and resists the pressure to arrive neatly resolved."
  />

  <div class="container layout">
    <nav class="toc" aria-label="On this page">
      <p class="eyebrow">On this page</p>
      <ol role="list">
        {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
      </ol>
    </nav>

    <div class="content">
      {guidelines.intro && <p class="prose intro">{guidelines.intro}</p>}

      <section id="open-call">
        <h2 class="sr-only">Current open call</h2>
        <OpenCall />
      </section>

      <section id="what-we-accept">
        <h2>What we accept</h2>
        <p>
          <em>Interstice</em> is built around the belief that unfinished work is not without value. We welcome:
        </p>
        <ul>
          {guidelines.accept.map((item) => <li>{item}</li>)}
        </ul>
        {
          guidelines.limits.length > 0 ? (
            <>
              <h3>Limits</h3>
              <ul>
                {guidelines.limits.map((item) => <li>{item}</li>)}
              </ul>
            </>
          ) : (
            <p class="muted">Limits for each form will be published with each open call.</p>
          )
        }
      </section>

      <section id="how-to-submit">
        <h2>How to submit</h2>
        <p>Send your submission by email to <a href={`mailto:${email}`}>{email}</a>.</p>
        <ul>
          {guidelines.subjectLine && (
            <li>
              Subject line: <code>{guidelines.subjectLine}</code>
            </li>
          )}
          {guidelines.include.map((item) => <li>{item}</li>)}
        </ul>
        {
          guidelines.formats.length > 0 && (
            <>
              <h3>File formats</h3>
              <ul>
                {guidelines.formats.map((item) => <li>{item}</li>)}
              </ul>
            </>
          )
        }
        {
          !hasRightsOrFees && (
            <p class="muted">
              {guidelines.formats.length > 0
                ? 'Details on rights and fees will be published with each open call.'
                : 'Details on rights, fees and file formats will be published with each open call.'}
            </p>
          )
        }
      </section>

      {
        hasRightsOrFees && (
          <section id="rights-and-fees">
            <h2>Rights and fees</h2>
            {guidelines.rights && <p>{guidelines.rights}</p>}
            {guidelines.fees && <p>{guidelines.fees}</p>}
          </section>
        )
      }

      <section id="what-happens-next">
        <h2>What happens next</h2>
        <p>
          Every submission is read by the <a href={`${INTERSTICE}editorial-team/`}>editorial team</a>.
          {guidelines.responseTime ? ` ${guidelines.responseTime}` : ' We will be in touch after the call closes.'}
        </p>
      </section>

      <section id="other-enquiries">
        <h2>Books and other enquiries</h2>
        <p>
          {guidelines.otherEnquiries} Please <a href="/contact/">get in touch</a>.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-m);
  }

  @media (min-width: 56rem) {
    .layout {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--space-l);
    }

    .toc {
      position: sticky;
      top: 9rem;
      align-self: start;
    }
  }

  .toc ol {
    border-left: 1px solid var(--rule);
  }

  .toc a {
    display: block;
    padding: 0.35rem 0 0.35rem 1rem;
    font-family: var(--mono);
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--ink-2);
  }

  .toc a:hover {
    color: var(--accent);
  }

  .content {
    max-width: var(--measure);
  }

  .content > * + * {
    margin-top: var(--space-l);
  }

  .content section {
    scroll-margin-top: 9rem;
  }

  .content h2 {
    font-size: var(--step-3);
    margin-bottom: 1.25rem;
  }

  .content h3 {
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--sage-ink);
    margin: 1.5rem 0 0.5rem;
  }

  .content ul {
    padding-left: 1.25rem;
    margin: 0 0 1em;
  }

  .content li + li {
    margin-top: 0.4rem;
  }

  code {
    font-family: var(--mono);
    font-size: 0.85em;
    background: var(--paper-2);
    padding: 0.1em 0.4em;
    overflow-wrap: anywhere;
  }
</style>
