---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import site from '../content/settings/site.json';
---

<BaseLayout
  title="Contact"
  description="Ananke Projects is open to conversations, collaborations and ideas."
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
>
  <header class="container contact-head">
    <p class="eyebrow eyebrow--accent">Contact</p>
    <h1 class="contact-title">Let's Talk</h1>
    <p class="lead contact-lead">Ananke Projects is open to conversations, collaborations and ideas.</p>
  </header>

  <section class="section container">
    <div class="split">
      <p class="eyebrow">Enquiries</p>
      <div>
        <p class="prose">
          For exhibition proposals, publishing enquiries, research collaborations, partnerships, community projects or
          general enquiries:
        </p>
        <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>

  <section class="section container">
    <div class="split">
      <p class="eyebrow">Follow</p>
      <a class="social" href={site.instagram} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"></circle>
        </svg>
        <span>Instagram <span class="muted">{site.instagramHandle}</span></span>
      </a>
    </div>
  </section>

  <section class="container">
    <div class="submissions theme-interstice">
      <p class="eyebrow eyebrow--accent">For publication submissions</p>
      <p class="submissions-text">Please consult the current submission guidelines for Ananke Editions.</p>
      <ArrowLink href="/projects/publications/submissions/" variant="solid">View submission guidelines</ArrowLink>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-head {
    padding-top: var(--space-l);
    padding-bottom: var(--space-m);
  }

  .contact-title {
    font-size: var(--step-5);
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .contact-lead {
    max-width: 30ch;
    margin-top: var(--space-m);
  }

  .email {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: var(--step-3);
    text-decoration-color: var(--accent);
    overflow-wrap: anywhere;
  }

  .social {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--step-1);
    text-decoration: none;
  }

  .social:hover span {
    text-decoration: underline;
  }

  .submissions {
    border: 1px solid var(--interstice);
    border-radius: var(--radius);
    padding: var(--space-m);
    background: color-mix(in srgb, var(--interstice) 5%, var(--paper));
  }

  .submissions-text {
    font-size: var(--step-2);
    margin-bottom: 1.5rem;
    max-width: 30ch;
  }
</style>
